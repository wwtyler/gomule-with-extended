{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Set UTF-8 Encoding",
            "type": "shell",
            "command": "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; [Console]::InputEncoding = [System.Text.Encoding]::UTF8; chcp 65001",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Build Project",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "args": ["build", "-x", "test"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Project with Tests",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "args": ["build"],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "args": ["clean"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run GoMule",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "args": ["run"],
            "group": "none",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "dependsOn": ["Set UTF-8 Encoding"]
        },
        {
            "label": "Run GoMule in Debug Mode",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "args": ["runDebug"],
            "group": "none",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "isBackground": true,
            "dependsOn": ["Set UTF-8 Encoding"]
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "args": ["test"],
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Create Distribution",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew",
            "args": ["createDistribution"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
